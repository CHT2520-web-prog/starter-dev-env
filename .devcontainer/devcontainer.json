{
  "name": "PHP, MariaDB and Node",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    // Node.js (LTS) and npm, for Vite / React
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  // The app shares the db container's network, so these cover both
  "forwardPorts": [8000, 8080, 5173, 3306],
  "portsAttributes": {
    "8000": { "label": "Laravel / PHP server", "onAutoForward": "openBrowser" },
    "8080": { "label": "Adminer", "onAutoForward": "notify" },
    "5173": { "label": "Vite dev server" },
    "3306": { "label": "MariaDB", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-mysql"
      ]
    }
  }
}
